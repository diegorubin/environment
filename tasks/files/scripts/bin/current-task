#!/bin/bash

PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

current_ticket=`golem get current ticket`
current_task=`golem get current task`

if [ -z "$current_ticket" ]; then
  if [ -z "$current_task" ]; then
    echo "Nothing"
  else
    echo "$current_task"
  fi
else
  echo "#$current_ticket - $current_task"
fi
